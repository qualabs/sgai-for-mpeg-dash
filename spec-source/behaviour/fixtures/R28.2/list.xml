<?xml version="1.0" encoding="UTF-8"?>
<svta:OverlayList xmlns="urn:mpeg:dash:schema:mpd:2011"
                  xmlns:svta="urn:svta:dash:sgai:2026"
                  family="overlay"
                  dismissAfter="never">
  <!-- A ClickThrough with a destination and no click-tracking. -->
  <svta:Ad>
    <svta:RenderableAsset src="https://ads-cdn.example.com/b/r28-2/c1.png"
                          mimeType="image/png" duration="PT4S" layout="overlay-corner"/>
    <svta:Tracking schemeIdUri="urn:mpeg:dash:event:callback:2015" value="1"
                   timescale="1000">
      <Event presentationTime="0" id="1">https://t.example.com/r28-2/imp?c=1</Event>
    </svta:Tracking>
    <svta:ClickThrough uri="https://brand-r28.example.com/c1"/>
  </svta:Ad>
  <!-- A ClickThrough with two click-tracking URLs. -->
  <svta:Ad>
    <svta:RenderableAsset src="https://ads-cdn.example.com/b/r28-2/c2.png"
                          mimeType="image/png" duration="PT4S" layout="overlay-corner"/>
    <svta:Tracking schemeIdUri="urn:mpeg:dash:event:callback:2015" value="1"
                   timescale="1000">
      <Event presentationTime="0" id="1">https://t.example.com/r28-2/imp?c=2</Event>
    </svta:Tracking>
    <svta:ClickThrough uri="https://brand-r28.example.com/c2"
                       trackingUris="https://t.example.com/r28-2/click?c=2 https://t2.example.com/r28-2/click?c=2"/>
  </svta:Ad>
</svta:OverlayList>
