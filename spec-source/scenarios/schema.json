{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sgai:scenario-vector:1",
  "title": "A use case of context/04, or a criterion of context/03, as an executable vector (ADR 0064, ADR 0077)",
  "description": "A UC vector is spec-source/scenarios/UC-NN.yaml and carries uc + uc_sha256; a behaviour test is spec-source/behaviour/R<n>.<m>[-<k>].yaml and carries criterion + criterion_sha256 instead, never both. Every time is an integer in units of 1/timescale seconds on the session clock: how far the session has got since the first frame of the session was presented (the primary content's, or what the Player presents in its place at the start), measured by what is presented: the media time, divided by its playback rate, of the primary content while it plays and of a linear ad while it has taken over the screen; wall-clock time while the viewer has paused and while what is shown has no media time (an image or HTML takeover, the content held by the Player); a stall stands it still and a seek's jump does not advance it. Whatever happens before that frame is at 0. README.md beside this file says where each value is read from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "timescale", "tolerance", "play_from", "observe_until",
               "entry", "fixtures", "player_capabilities", "sends_capabilities", "actions", "outcomes"],
  "oneOf": [
    {"required": ["uc", "uc_sha256", "missing_carrier", "disagreements"],
     "not": {"anyOf": [{"required": ["criterion"]}, {"required": ["criterion_sha256"]}]}},
    {"required": ["criterion", "criterion_sha256"],
     "not": {"anyOf": [{"required": ["uc"]}, {"required": ["uc_sha256"]},
                       {"required": ["missing_carrier"]}, {"required": ["disagreements"]}]},
     "description": "a criterion whose carrier is missing is a NOT_VERIFIABLE entry of behaviour/index.yaml, not a test (ADR 0084)"}
  ],
  "properties": {
    "format": {"const": "sgai-scenario/1"},
    "uc": {"type": "string", "pattern": "^UC-[0-9]{2}$"},
    "uc_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                  "description": "sha256 of the UC's section of context/04, from its `### UC-NN` line to the next heading of level 1 to 3 (or the end of the file), as UTF-8 bytes"},
    "criterion": {"type": "string", "pattern": "^R[0-9]+\\.[0-9]+$",
                  "description": "the criterion of context/03 the test decides"},
    "criterion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                         "description": "sha256 of the criterion's text as bin/conformance/spec/criteria.py defines it (whitespace-normalised); print it with `check-behaviour.py criterion R<n>.<m>`"},
    "timescale": {"type": "integer", "minimum": 1},
    "tolerance": {"type": "integer", "minimum": 0,
                  "description": "how far an executor may observe an exact time from the one written, in timescale units"},
    "play_from": {"type": "integer", "minimum": 0,
                  "description": "the main presentation's time at which playback is started"},
    "observe_until": {"type": "integer", "minimum": 1,
                      "description": "session-clock time at which observation ends"},
    "entry": {"$ref": "#/$defs/path",
              "description": "the fixture the Player is given as its main MPD"},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}},
    "player_capabilities": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^D[1-5]$": {"$ref": "#/$defs/capabilities"}},
      "properties": {"legacy": {"$ref": "#/$defs/legacy_capabilities"}}
    },
    "sends_capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["sgai-video-decoders", "sgai-image-over-video", "sgai-html-over-video",
                         "sgai-custom-layout", "sgai-ad-audio"]},
      "description": "the capability parameters the Player discloses on a resolution request (R29.2); every class of the vector sends the same names"
    },
    "actions": {"$ref": "#/$defs/actions"},
    "aps": {
      "type": "array",
      "description": "how the test APS answers any URL an entry names: a resolution request, a document, a media segment or a creative. Without it, or for a URL it does not name, a fixture's URL is answered at once with status 200 and that fixture",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["url"],
        "oneOf": [{"required": ["status"]}, {"required": ["no_response"]}],
        "properties": {
          "url": {"type": "string", "pattern": "^https?://",
                  "description": "the URL as the document pointing to it writes it (a request's `url`, a segment's or a creative's address), without the query the Player adds"},
          "nth": {"type": "integer", "minimum": 1,
                  "description": "which request to that URL this answers, 1-based; absent: every one"},
          "status": {"type": "integer", "minimum": 100, "maximum": 599},
          "document": {"$ref": "#/$defs/path", "description": "the body served, a fixture of the vector; absent: an empty body"},
          "delay": {"$ref": "#/$defs/time", "description": "how long after the request the answer starts"},
          "no_response": {"const": true, "description": "the APS never answers: the request stays open until observation ends"}
        },
        "dependentSchemas": {
          "no_response": {"not": {"anyOf": [{"required": ["document"]}, {"required": ["delay"]}]}}
        }
      }
    },
    "outcomes": {"$ref": "#/$defs/outcomes"},
    "variants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "actions", "outcomes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string"},
          "actions": {"$ref": "#/$defs/actions"},
          "outcomes": {"$ref": "#/$defs/outcomes"}
        }
      }
    },
    "missing_carrier": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement", "element", "classes"],
        "properties": {
          "requirement": {"type": "string", "pattern": "^R[0-9]+(\\.[0-9]+[a-z]?)?$"},
          "element": {"type": "string", "minLength": 1},
          "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/class"}},
          "variant": {"type": "string"}
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["context", "annex", "recorded"],
        "properties": {
          "context": {"type": "string", "minLength": 1, "description": "what context/04 says, quoted, with where"},
          "annex": {"type": "string", "minLength": 1, "description": "what the annex says, quoted, with where"},
          "recorded": {"type": "string", "minLength": 1, "description": "which of the two the outcomes follow, and that it is not resolved here"}
        }
      }
    }
  },
  "$defs": {
    "class": {"enum": ["D1", "D2", "D3", "D4", "D5", "legacy"]},
    "path": {"type": "string", "pattern": "^(examples|scenarios/fixtures/UC-[0-9]{2}|behaviour/fixtures)/[A-Za-z0-9._/-]+$"},
    "time": {"type": "integer", "minimum": 0},
    "tolerance": {"type": "integer", "minimum": 0,
                  "description": "this item's tolerance, in timescale units, in place of the vector's"},
    "when": {
      "oneOf": [
        {"$ref": "#/$defs/time"},
        {"type": "object", "additionalProperties": false, "required": ["from", "to"],
         "properties": {"from": {"$ref": "#/$defs/time"}, "to": {"$ref": "#/$defs/time"}}}
      ]
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "url": {"type": "string", "pattern": "^https?://", "description": "where the harness serves it: the URL the Player requests it from"},
        "class": {"enum": ["publisher-mpd", "legacy-view", "list-mpd", "sps-mpd", "overlay-list", "request", "fragment", "vast"],
                  "description": "required for a fixture under scenarios/fixtures/ or behaviour/fixtures/; for one under examples/ it is read from examples/index.yaml"},
        "expect_red": {"type": "array", "minItems": 1, "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9.-]*$"},
                       "description": "a fixture deliberately non-conformant at levels 1 and 2 (a test of what a Player does with a defective document): the rule ids that fail on it, exactly; the check finds a rule failing that is not listed, or one listed that does not fail"}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["sgai-video-decoders", "sgai-image-over-video", "sgai-html-over-video",
                   "sgai-custom-layout", "sgai-ad-audio"],
      "properties": {
        "sgai-video-decoders": {"enum": [1, 2, 3]},
        "sgai-image-over-video": {"enum": [0, 1]},
        "sgai-html-over-video": {"enum": [0, 1]},
        "sgai-custom-layout": {"enum": [0, 1]},
        "sgai-ad-audio": {"enum": [0, 1]}
      }
    },
    "legacy_capabilities": {
      "type": "object", "additionalProperties": false, "required": ["predates_spec"],
      "properties": {"predates_spec": {"const": true}, "sgai-video-decoders": {"enum": [1, 2, 3]}}
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "do"],
        "properties": {
          "at": {"$ref": "#/$defs/time"},
          "do": {"enum": ["pause", "resume", "seek", "dismiss", "activate", "rate"]},
          "to": {"$ref": "#/$defs/time", "description": "seek: the main presentation time sought"},
          "rate": {"type": "number", "exclusiveMinimum": 0, "description": "rate: the new playback rate"}
        },
        "allOf": [
          {"if": {"properties": {"do": {"const": "seek"}}}, "then": {"required": ["to"]}},
          {"if": {"properties": {"do": {"const": "rate"}}}, "then": {"required": ["rate"]}}
        ]
      }
    },
    "candidate_ref": {
      "type": "object", "additionalProperties": false, "required": ["fixture"],
      "oneOf": [{"required": ["id"]}, {"required": ["index"]}],
      "properties": {
        "fixture": {"$ref": "#/$defs/path"},
        "id": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 1, "description": "1-based document order among the document's candidates"}
      }
    },
    "option_ref": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["index"],
         "properties": {"index": {"type": "integer", "minimum": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["id"],
         "properties": {"id": {"type": "string", "minLength": 1}}}
      ]
    },
    "element": {
      "type": "object", "additionalProperties": false, "required": ["element"],
      "properties": {
        "element": {"enum": ["primary", "ad", "background"]},
        "from": {"$ref": "#/$defs/when", "description": "primary: the main presentation time shown at the segment's start; a window {from, to} when that start is itself a window and the primary plays across it"},
        "tolerance": {"$ref": "#/$defs/tolerance", "description": "primary: for its `from` alone, in place of the segment's"},
        "candidate": {"$ref": "#/$defs/candidate_ref"},
        "option": {"$ref": "#/$defs/option_ref"},
        "region": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"element": {"const": "primary"}}}, "then": {"required": ["from"]},
         "else": {"not": {"required": ["tolerance"]}}},
        {"if": {"properties": {"element": {"const": "ad"}}}, "then": {"required": ["candidate", "option"]}}
      ]
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "requests", "selection", "presentation", "beacons"],
      "dependentRequired": {"clicks": ["destinations"], "destinations": ["clicks"]},
      "if": {"required": ["requests_not_compared"]},
      "then": {"properties": {"requests": {"maxItems": 0}}},
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "requests_not_compared": {"type": "string", "minLength": 1,
                                  "description": "why this outcome's requests are not compared (the criterion binds what is presented, not what is requested); `requests` is then empty"},
        "clicks": {
          "type": "array",
          "description": "every click-tracking URL fired, each a URL of its candidate's ClickThrough@trackingUris; with it, a ClickThrough's click-tracking URLs are judged here and not as beacons",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "fixture", "candidate", "url"],
            "properties": {
              "at": {"$ref": "#/$defs/when"},
              "tolerance": {"$ref": "#/$defs/tolerance"},
              "fixture": {"$ref": "#/$defs/path"},
              "candidate": {"$ref": "#/$defs/candidate_ref"},
              "url": {"type": "string", "pattern": "^https?://"}
            }
          }
        },
        "destinations": {
          "type": "array",
          "description": "every ClickThrough destination made available to the viewer: the candidate's ClickThrough@uri opened (a request to it) or shown on screen",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "fixture", "candidate"],
            "properties": {
              "at": {"$ref": "#/$defs/when"},
              "tolerance": {"$ref": "#/$defs/tolerance"},
              "fixture": {"$ref": "#/$defs/path"},
              "candidate": {"$ref": "#/$defs/candidate_ref"}
            }
          }
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "url"],
            "properties": {
              "at": {"$ref": "#/$defs/when"},
              "tolerance": {"$ref": "#/$defs/tolerance"},
              "url": {"type": "string", "pattern": "^https?://"},
              "query": {"type": "object", "additionalProperties": {"type": "string"},
                        "description": "query parameters the Player adds to url"},
              "extra_query_pattern": {"type": "string", "minLength": 1,
                                      "description": "a regular expression: the Player may add, beyond `query`, any parameter whose whole name it matches (R29.4's vendor-prefixed names)"},
              "answered_by": {"$ref": "#/$defs/path", "description": "the fixture served; absent only when `aps` answers that URL without a document"},
              "matches": {"$ref": "#/$defs/path", "description": "a request fixture (.http) this request equals"}
            }
          }
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["opportunity", "result", "presented"],
            "properties": {
              "opportunity": {
                "type": "object", "additionalProperties": false, "required": ["fixture", "event_id"],
                "properties": {"fixture": {"$ref": "#/$defs/path"}, "event_id": {"type": "string"}}
              },
              "result": {"enum": ["presented", "declined", "ignored"],
                         "description": "ignored: the Player does not recognise the opportunity (a legacy Player)"},
              "presented": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["candidate", "option", "layout"],
                  "properties": {
                    "candidate": {"$ref": "#/$defs/candidate_ref"},
                    "option": {"$ref": "#/$defs/option_ref"},
                    "layout": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "presentation": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["start", "end", "layout", "shows"],
            "properties": {
              "start": {"$ref": "#/$defs/when", "description": "a window {from, to} when the instant is the Player's to choose; the previous segment's `end` is the same value"},
              "end": {"$ref": "#/$defs/when"},
              "tolerance": {"$ref": "#/$defs/tolerance", "description": "for this segment's start boundary and its primary's `from` (unless the primary carries its own), in place of the vector's"},
              "layout": {"type": "string", "description": "an R12.2 token, or `none` when only the primary content is on screen"},
              "shows": {"type": "array", "items": {"$ref": "#/$defs/element"}},
              "audio": {"enum": ["primary", "ad", "none"]},
              "note": {"type": "string"}
            }
          }
        },
        "beacons": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "fixture", "id"],
            "properties": {
              "at": {"$ref": "#/$defs/when"},
              "tolerance": {"$ref": "#/$defs/tolerance"},
              "fixture": {"$ref": "#/$defs/path"},
              "candidate": {"$ref": "#/$defs/candidate_ref", "description": "when the beacon's @id is scoped by its candidate"},
              "id": {"type": "string"},
              "url": {"type": "string"}
            }
          }
        },
        "geometry": {
          "type": "array",
          "description": "where the ad layer and the primary content are on screen at an instant",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["at", "tolerance"],
            "anyOf": [{"required": ["primary"]}, {"required": ["ad"]}],
            "properties": {
              "at": {"$ref": "#/$defs/time"},
              "primary": {"$ref": "#/$defs/rect"},
              "ad": {"$ref": "#/$defs/rect", "description": "the bounding box of the ad layer, every element of the ad included"},
              "tolerance": {"type": "number", "minimum": 0,
                            "description": "how far an executor may observe each edge from the written one, in percentage points"}
            }
          }
        }
      }
    },
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "description": "a rectangle in percent of the Player's viewport, origin top-left (as R39.2)",
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 100},
        "y": {"type": "number", "minimum": 0, "maximum": 100},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
      }
    },
    "outcomes": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^(D[1-5]|legacy)$": {"$ref": "#/$defs/outcome"}}
    }
  }
}
