<?xml version="1.0" encoding="UTF-8"?>
<svta:OverlayList xmlns="urn:mpeg:dash:schema:mpd:2011"
                  xmlns:svta="urn:svta:dash:sgai:2026"
                  family="overlay"
                  dismissAfter="PT5S">
  <svta:Ad>
    <!-- 1: L-shape, video full-frame creative (sold with its audio; no carrier declares it) -->
    <svta:RenderableAsset src="https://ads-cdn.example.com/nl/1801/lshape-video.mpd"
                          mimeType="application/dash+xml"
                          layout="squeezeback-l-shape-upper-left"/>
    <!-- 2: L-shape, image full-frame creative -->
    <svta:RenderableAsset src="https://ads-cdn.example.com/nl/1801/lshape.jpg"
                          mimeType="image/jpeg" duration="PT30S"
                          layout="squeezeback-l-shape-upper-left"/>
    <svta:Tracking schemeIdUri="urn:mpeg:dash:event:callback:2015" value="1"
                   timescale="1000">
      <Event presentationTime="0" id="1">https://t.example.com/imp?cr=1801</Event>
      <Event presentationTime="15000" id="2">https://t.example.com/mid?cr=1801</Event>
      <Event presentationTime="30000" id="3">https://t.example.com/complete?cr=1801</Event>
    </svta:Tracking>
    <svta:AdSystem>ExampleAds</svta:AdSystem>
    <svta:AdTitle>Sports drink, lull L-shape</svta:AdTitle>
  </svta:Ad>
</svta:OverlayList>
