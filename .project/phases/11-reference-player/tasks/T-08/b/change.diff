+  // §5.6: a candidate's <svta:ClickThrough>, { uri, tracking: [url] }, both
+  // resolved against the document's URL; null when the candidate has none.
+  function clickThroughOf(ad, docUrl) {
+    const ct = children(ad, 'ClickThrough', SVTA)[0];
+    const uri = ct && (ct.getAttribute('uri') || '').trim();
+    if (!uri) return null;
+    const abs = (u) => { try { return new URL(u, docUrl).href; } catch (e) { return u; } };
+    const list = (ct.getAttribute('trackingUris') || '').trim();
+    return { uri: abs(uri), tracking: list ? list.split(/\s+/).map(abs) : [] };
+  }
